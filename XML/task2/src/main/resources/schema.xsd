<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="people">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="person" type="PersonType" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="PersonType">
        <xs:sequence>
            <xs:element name="firstName" type="xs:string" minOccurs="0"/>
            <xs:element name="lastName" type="xs:string" minOccurs="0"/>
            <xs:element name="gender" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="M"/>
                        <xs:enumeration value="F"/>
                        <xs:enumeration value="male"/>
                        <xs:enumeration value="female"/>
                        <xs:enumeration value="UNKNOWN"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="spouse" type="xs:IDREF" minOccurs="0"/>
            <xs:element name="father" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="mother" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="son" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="daughter" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="brother" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="sister" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>
</xs:schema>
